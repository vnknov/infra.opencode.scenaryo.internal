{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.5",
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (inference.scenaryo.internal)",
      "options": {
        "baseURL": "https://inference.scenaryo.internal/v1",
        "apiKey": "{env:LM_STUDIO_TOKEN}"
      },
      "models": {
        "qwen/qwen3-coder-next": {
          "name": "Qwen3 Coder Next 80B (LM Studio)"
        }
      }
    }
  },
  "mcp": {
    "obsidian": {
      "type": "remote",
      "url": "https://thinkstationpgx-d37b.local:27124/mcp/",
      "enabled": true,
      "oauth": false,
      "timeout": 10000,
      "headers": {
        "Authorization": "Bearer {env:OBSIDIAN_API_KEY}"
      }
    },
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp/authv2",
      "enabled": true
    },
    "channels": {
      "type": "remote",
      "url": "http://192.168.40.139:3000/mcp",
      "enabled": true,
      "oauth": false,
      "timeout": 30000,
      "headers": {
        "Authorization": "Bearer {env:CHANNELS_MCP_TOKEN}"
      }
    }
  }
}
